{
  "name": "spotify-lyrics-overlay",
  "private": true,
  "version": "1.0.11",
  "description": "Live-synced Spotify & YT Music lyrics overlay for desktop.",
  "author": "Lyrics Overlay Contributors",
  "type": "module",
  "main": "public/electron.cjs",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "test": "eslint .",
    "build": "eslint . && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "dist": "eslint . && vite build && electron-builder",
    "dist:linux": "eslint . && vite build && electron-builder --linux",
    "dist:mac": "eslint . && vite build && electron-builder --mac",
    "dist:win": "eslint . && vite build && electron-builder --win",
    "version:current": "node scripts/version.cjs",
    "version:patch": "node scripts/version.cjs patch",
    "version:minor": "node scripts/version.cjs minor",
    "version:major": "node scripts/version.cjs major",
    "release:patch": "node scripts/version.cjs patch && pnpm run dist",
    "release:minor": "node scripts/version.cjs minor && pnpm run dist",
    "release:major": "node scripts/version.cjs major && pnpm run dist"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "spotify-web-api-js": "^1.5.2",
    "ytmusic-api": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^36.2.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@biomejs/biome"
    ]
  },
  "build": {
    "appId": "com.spotifylyricsoverlay.app",
    "productName": "Lyrics Overlay",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "public/electron.cjs",
      "public/preload.cjs",
      "public/mediaDetector.cjs",
      "public/services/**/*",
      "public/icon.png",
      "!**/node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "category": "Audio"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.music"
    }
  }
}
